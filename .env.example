# --- Discord ---------------------------------------------------------------
TOKEN=your-bot-token-here
OWNER_IDS=931037124336164957          # comma-separated Discord user IDs

# --- Sharding ----------------------------------------------------------------
# Leave SHARD_COUNT unset (or 0) to let discord.py auto-compute the shard
# count from Discord's recommended value. Set explicitly in multi-process
# deployments where each process owns a fixed shard range (SHARD_IDS).
SHARD_COUNT=0
SHARD_IDS=                            # e.g. "0,1,2" for this process only
CLUSTER_ID=0                          # identifies this process in multi-process/multi-host setups

# --- MongoDB (document store: guild config, tags, greetings, autoroles) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=bcommie

# --- PostgreSQL (relational store: reminders, giveaways, timezones, audit) -
POSTGRES_DSN=postgresql://bcommie:bcommie@localhost:5432/bcommie
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                       # json | console

# --- Security ------------------------------------------------------------------
COMMAND_RATE_LIMIT_PER_MINUTE=20
ENABLE_AUDIT_LOG=false

# --- Dashboard API (optional, extensibility) --------------------------------
DASHBOARD_ENABLED=false
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_JWT_SECRET=change-me # yeah you should change this instead of using the default value, this is just representative lmao
